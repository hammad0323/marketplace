# Optional hardening — the site works without this file (every page is
# a real .php file, no URL rewriting is needed). This just adds a
# couple of extra safety nets on top of the guards already built into
# config/, includes/, and templates/ (see their own .htaccess files).

Options -Indexes

# database.sql contains your schema and demo data (including a
# password hash) — no reason for it to be downloadable once imported.
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
