# Every page is a real .php file — no URL rewriting required for the site
# to function. This file only adds defense-in-depth hardening.

Options -Indexes
ServerSignature Off

# config.php, functions.php and auth.php already refuse direct access on
# their own (see the guards at the top of each file); this blocks the HTTP
# route entirely as a second layer.
<FilesMatch "^(config|functions|auth)\.php$">
    Require all denied
</FilesMatch>

# Never serve the schema/seed SQL, .env, or log files over HTTP.
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

# Block direct access to include/config directories even though every file
# inside also guards itself.
RewriteEngine On
RewriteRule ^(config|includes)/ - [F,L]

# Uploaded files must never execute as PHP — enforced by uploads/.htaccess
# (a separate, directory-scoped file) rather than here, since disabling the
# PHP engine site-wide by mistake is exactly the failure mode to avoid.

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.php
