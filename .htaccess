# Clean URLs: every page is still a real .php file on disk, but visitors
# never see the .php extension. See the two rewrite blocks below for how.
# This file also adds defense-in-depth hardening (blocked files/dirs,
# security headers).

Options -Indexes
ServerSignature Off

# config.php, functions.php and auth.php already refuse direct access on
# their own (see the guards at the top of each file); this blocks the HTTP
# route entirely as a second layer.
<FilesMatch "^(config|functions|auth)\.php$">
    Require all denied
</FilesMatch>

# Never serve the schema/seed SQL, .env, or log files over HTTP.
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Block direct access to include/config directories even though every file
# inside also guards itself.
RewriteRule ^(config|includes)/ - [F,L]

# Flag private/non-content areas for the X-Robots-Tag header below.
# robots.txt's Disallow only stops crawling — it does nothing to stop a URL
# from being indexed (with no snippet) if a search engine finds it linked
# elsewhere, so this closes that gap with the header engines actually key
# noindex off. Matched by an env var (not a hardcoded header block) so it
# keeps working through the clean-URL rewrites below instead of racing them.
RewriteRule ^(admin|doctor|patient|pharmacy|ajax)(/|$) - [E=NOINDEX:1]

# ---------------------------------------------------------------------------
# Clean URLs
# ajax/, assets/, uploads/, database/ keep their real paths — only the
# user-facing pages get the extension hidden.
# ---------------------------------------------------------------------------

# 1) Canonicalize: a browser landing on /page.php (bookmark, old link, search
#    result) is redirected once to the clean /page URL. GET/HEAD only —
#    redirecting a POST would silently drop the request body.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /index\.php[?\s]
RewriteRule ^ /? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/ajax/
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^?\s]+)\.php[?\s]
RewriteRule ^ /%1 [R=301,L]

# 1b) Old ?slug=... detail URLs (doctor-profile, product-detail, blog-post,
#     medicine-detail) 301 to their new path-based equivalent below, so any
#     already-indexed or bookmarked link keeps working and search engines
#     re-index the new URL instead of treating both as duplicate content.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^doctor-profile$ /doctors/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^product-detail$ /products/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^blog-post$ /blog/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^medicine-detail$ /medicines/%1? [R=301,L]

# 2) Pretty detail-page URLs: the slug lives in the path, not a query string
#    (/doctors/{slug}, /products/{slug}, /medicines/{slug}, /blog/{slug},
#    /pharmacies/{slug}). These are plain files (doctors.php etc.), not
#    directories, and /doctor/*, /product/*, /medicine/*, /pharmacy/* are
#    never used, so this can't collide with the doctor/pharmacy dashboard
#    panels at /doctor/... or /pharmacy/....
RewriteRule ^doctors/([\w-]+)/?$ doctor-profile.php?slug=$1 [L,QSA]
RewriteRule ^products/([\w-]+)/?$ product-detail.php?slug=$1 [L,QSA]
RewriteRule ^medicines/([\w-]+)/?$ medicine-detail.php?slug=$1 [L,QSA]
RewriteRule ^blog/([\w-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^pharmacies/([\w-]+)/?$ pharmacy-profile.php?slug=$1 [L,QSA]

# 3) Serve the matching .php file for a clean-URL request, transparently
#    (no redirect, no visible change to the address bar).
RewriteCond %{REQUEST_URI} !^/(ajax|assets|uploads|database)/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Set only on the admin/doctor/patient/pharmacy/ajax paths flagged above.
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX
</IfModule>

# ---------------------------------------------------------------------------
# Static asset caching
# CSS/JS loaded through the shared header/footer includes carry a
# ?v=<mtime> query string (see asset_url() in includes/functions.php), so a
# full year is safe for them — editing the file changes its URL, which
# forces every browser to fetch the new copy regardless of what's cached.
# Everything else under /assets/ and /uploads/ (fonts, images, per-page
# feature scripts without a version string) gets a shorter but still
# "efficient" 30-day lifetime as a staleness safety net.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|eot|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # A URL carrying our own ?v=<mtime> cache-buster can be cached
    # immutably for a year — it will never be reused after the file changes.
    <If "%{QUERY_STRING} =~ /^v=\d+$/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# Compress text-based responses to cut transfer size.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

ErrorDocument 404 /404
