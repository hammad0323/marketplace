Options -MultiViews -Indexes
RewriteEngine On

# App internals are only ever require()'d by index.php — never serve
# them directly. Without this, requesting e.g. /database/seeds/..sql
# or /database/migrate.php over HTTP would be possible.
RewriteRule ^(includes|modules|partials|database|storage)(/|$) - [F,L]

# Serve real files (assets, etc.) directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller so PHP can match
# clean, query-string-free URLs like /artisan/wooden-crafts.
RewriteRule ^ index.php [QSA,L]
