# =====================================================================
#  Fahim Store - Apache configuration
#  Requires mod_rewrite. Clean URLs: every request that is not a real
#  file/folder is routed to index.php (front controller).
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If installed in a sub-folder, set it here, e.g.  RewriteBase /fahim-store/
    # RewriteBase /

    # --- Force HTTPS (uncomment on production with SSL) ---
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Force www or non-www (optional) ---
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Block direct access to internal folders & sensitive files
    RewriteRule ^(includes|pages|partials|database|tools|logs)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(sql|sh|log|md|lock|ini|bak|dist|cache)$ - [F,L,NC]

    # Never execute scripts inside uploads
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh)$ - [F,L,NC]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Deny access to configuration / include files directly
<FilesMatch "^(config|config\.local|database|functions|bootstrap)\.php$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|sh|log|md|ini|bak|cache)$">
    Require all denied
</FilesMatch>

# Custom error documents (front controller renders the pretty 404)
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php

# ---------------------------------------------------------------------
#  Performance: compression & browser caching
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>
