# Clean URLs: every page is still a real .php file on disk, but visitors
# never see the .php extension. See the two rewrite blocks below for how.
# This file also adds defense-in-depth hardening (blocked files/dirs,
# security headers).

Options -Indexes
ServerSignature Off

# config.php, functions.php and auth.php already refuse direct access on
# their own (see the guards at the top of each file); this blocks the HTTP
# route entirely as a second layer.
<FilesMatch "^(config|functions|auth)\.php$">
    Require all denied
</FilesMatch>

# Never serve the schema/seed SQL, .env, or log files over HTTP.
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Block direct access to include/config directories even though every file
# inside also guards itself.
RewriteRule ^(config|includes)/ - [F,L]

# ---------------------------------------------------------------------------
# Clean URLs
# ajax/, assets/, uploads/, database/ keep their real paths — only the
# user-facing pages get the extension hidden.
# ---------------------------------------------------------------------------

# 1) Canonicalize: a browser landing on /page.php (bookmark, old link, search
#    result) is redirected once to the clean /page URL. GET/HEAD only —
#    redirecting a POST would silently drop the request body.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /index\.php[?\s]
RewriteRule ^ /? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/ajax/
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^?\s]+)\.php[?\s]
RewriteRule ^ /%1 [R=301,L]

# 1b) Old ?slug=... detail URLs (doctor-profile, product-detail, blog-post,
#     medicine-detail) 301 to their new path-based equivalent below, so any
#     already-indexed or bookmarked link keeps working and search engines
#     re-index the new URL instead of treating both as duplicate content.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^doctor-profile$ /doctors/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^product-detail$ /products/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^blog-post$ /blog/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{QUERY_STRING} ^slug=([\w-]+)$
RewriteRule ^medicine-detail$ /medicines/%1? [R=301,L]

# 2) Pretty detail-page URLs: the slug lives in the path, not a query string
#    (/doctors/{slug}, /products/{slug}, /medicines/{slug}, /blog/{slug}).
#    These are plain files (doctors.php etc.), not directories, and
#    /doctor/*, /product/*, /medicine/* are never used, so this can't
#    collide with the doctor dashboard panel at /doctor/... or anything else.
RewriteRule ^doctors/([\w-]+)/?$ doctor-profile.php?slug=$1 [L,QSA]
RewriteRule ^products/([\w-]+)/?$ product-detail.php?slug=$1 [L,QSA]
RewriteRule ^medicines/([\w-]+)/?$ medicine-detail.php?slug=$1 [L,QSA]
RewriteRule ^blog/([\w-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# 3) Serve the matching .php file for a clean-URL request, transparently
#    (no redirect, no visible change to the address bar).
RewriteCond %{REQUEST_URI} !^/(ajax|assets|uploads|database)/
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404
