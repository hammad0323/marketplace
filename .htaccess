# =====================================================================
# Wedding Hall SaaS — Apache configuration
# Clean URLs, security hardening. Works even if mod_rewrite is
# unavailable on the host — every page also has its own literal
# filename (e.g. hall.php?slug=...), so nothing breaks if these rules
# are ignored, only the pretty URLs won't apply.
# =====================================================================

# ---- Block sensitive files ----
<FilesMatch "\.(sql|log|md|env|ini|bak|sh)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|functions|auth)\.php$">
    Require all denied
</FilesMatch>

# ---- No directory listing / no MultiViews guessing ----
Options -Indexes
Options -MultiViews
ServerSignature Off

# ---- Never execute PHP inside the uploads folder ----
<IfModule mod_php.c>
    <Directory "uploads">
        php_admin_flag engine off
    </Directory>
</IfModule>
<FilesMatch "\.(?:php|phtml|php\d)$">
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Require all denied
    </If>
</FilesMatch>

# ---- Security headers ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# ---- HTTPS redirect (enable once SSL is active on your domain) ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # No RewriteBase here on purpose: every substitution below is a
    # relative path (e.g. "hall.php?slug=$1"), so Apache resolves it
    # against whatever folder this .htaccess lives in. That means this
    # exact file works unmodified whether the app is installed at the
    # domain root or in a subfolder (e.g. https://example.com/beta/).

    # Canonical: strip a trailing index.php, staying inside the current subfolder
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^?\s]*)index\.php[?\s] [NC]
    RewriteRule ^index\.php$ %1 [L,R=301]

    # Dynamic robots.txt / sitemap.xml
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # /hall/{slug}
    RewriteRule ^hall/([a-zA-Z0-9-]+)/?$ hall.php?slug=$1 [L,QSA]
    # /blog/{slug}
    RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]
    # /booking-confirmation/{code}
    RewriteRule ^booking-confirmation/([A-Za-z0-9-]+)/?$ booking-confirmation.php?code=$1 [L,QSA]

    # /admin/{page} -> admin/{page}.php (only if that file really exists).
    # %{REQUEST_FILENAME} is Apache's own fully-resolved absolute path for
    # the current request (DOCUMENT_ROOT + the full URL, subfolder
    # included), so appending ".php" to it — instead of hand-building the
    # path from %{DOCUMENT_ROOT} — keeps this correct at any install depth.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L,QSA]
    RewriteRule ^admin/?$ admin/index.php [L,QSA]

    # Generic clean URL for every root-level page: /about -> about.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    # Catch-all 404: anything left unmatched (no real file/dir, and no
    # *.php it could be rewritten to above) gets our styled 404 page
    # internally, via the same relative-path mechanism as every rule
    # above — so, like the rest of this file, it needs no editing at any
    # install depth. 404.php itself sets the real "404 Not Found" status.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

DirectoryIndex index.php

# Fallback only for requests mod_rewrite never saw (e.g. a direct hit on
# a .php file that errors, or mod_rewrite disabled). If this app is
# installed in a subfolder, prefix these three with that subfolder
# (e.g. /beta/404.php) — ErrorDocument paths are always resolved from
# the server root, unlike everything else in this file.
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# ---- Sensible defaults ----
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>
