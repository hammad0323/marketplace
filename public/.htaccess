Options -MultiViews
RewriteEngine On

# Serve real files/assets directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller so PHP can match
# clean, query-string-free URLs like /artisan/wooden-crafts.
RewriteRule ^ index.php [QSA,L]
