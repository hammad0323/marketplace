# QualityCore - basic hardening. Safe to delete if your host doesn't support .htaccess
# (Nginx/LiteSpeed ignore it; apply the equivalent deny rules in your server config instead).
Options -Indexes

<FilesMatch "^(README\.md|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
