# Second layer of protection (the code itself also refuses direct
# access to these files even if mod_rewrite/.htaccess isn't honored).
<FilesMatch "\.(sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag display_errors off
</IfModule>

Options -Indexes

# ------------------------------------------------------------------
# Clean URLs (no ".php" in any public link) + safe subfolder deploy.
#
# Nothing below hardcodes a domain or a subfolder name (no RewriteBase,
# no leading-slash targets) — every rule resolves relative to whatever
# directory this .htaccess lives in, so uploading this project into a
# subfolder (e.g. www.example.com/tools/) or a domain root both work
# without editing this file. Route files on disk keep their real
# ".php" extension (Apache/PHP require that to execute them); only the
# public-facing URL loses the extension.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. A request that literally still ends in ".php" gets redirected to
  #    its extension-less form (avoids the same page existing at two
  #    URLs, which search engines treat as duplicate content). Skips
  #    /admin/, /api/ and /crm/, which intentionally keep their .php
  #    URLs (internal apps, not public/indexed pages).
  RewriteCond %{REQUEST_URI} !^/(.*/)?admin/ [NC]
  RewriteCond %{REQUEST_URI} !^/(.*/)?api/ [NC]
  RewriteCond %{REQUEST_URI} !^/(.*/)?crm/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.*)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # 2. Real files (CSS/JS/images, admin/*.php, the tool .php files once
  #    reached internally, etc.) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Clean URL → real file: /salary-calculator internally serves
  #    salary-calculator.php if that file exists (same for categories,
  #    static pages, and blog/<slug>). Checked BEFORE the plain
  #    directory passthrough below, so e.g. /blog correctly serves
  #    blog.php even though a same-named blog/ directory also exists
  #    (it holds the individual blog post files).
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]

  # 4. A real directory with no matching ".php" sibling (assets/,
  #    uploads/) is served as-is.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Nothing matched — hand off to the custom 404 page.
  RewriteRule ^ 404.php [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
