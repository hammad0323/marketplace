# Proposal Maker — Apache / cPanel / Hostinger configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the app lives in a sub-folder and links 404, set RewriteBase, e.g.:
    # RewriteBase /proposals/
    RewriteRule ^proposal/view/([A-Za-z0-9]+)/?$ view.php?token=$1 [L,QSA]
</IfModule>

# Protect internal files
<FilesMatch "^(config\.php|config\.sample\.php|database\.sql|composer\.(json|lock)|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 16M
    php_value memory_limit 256M
    php_value max_execution_time 120
</IfModule>
