# Uploaded files are data only - never executable.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|jsp|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "script-src 'none'"
    </FilesMatch>
</IfModule>
